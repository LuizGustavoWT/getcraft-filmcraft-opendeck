{
  "Name": "FilmCraft Editing Controls",
  "Description": "Timeline, marker, shuttle, jog, color, and audio controls for a running FilmCraft session.",
  "Author": "LuizGustavoWT",
  "Version": "0.1.0",
  "PluginUUID": "wt.luizgustavo.getcraft.filmcraft",
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/getcraft-filmcraft-opendeck"
  },
  "CodePathLin": "x86_64-unknown-linux-gnu/bin/getcraft-filmcraft-opendeck",
  "Icon": "assets/icon",
  "Category": "GetCraft",
  "OS": [{ "Platform": "linux" }],
  "Actions": [{
