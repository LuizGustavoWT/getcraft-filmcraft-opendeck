  }, {
    "UUID": "wt.luizgustavo.getcraft.filmcraft.run",
    "Name": "Run FilmCraft CLI",
    "Icon": "assets/action",
    "States": [{
      "Image": "assets/action",
      "TitleAlignment": "bottom",
      "TitleColor": "#FFFFFF",
      "FontSize": "12"
    }],
    "Controllers": ["Keypad", "Encoder"],
    "SupportedInMultiActions": true,
    "Tooltip": "Run any FilmCraft CLI command using safe JSON arguments.",
    "PropertyInspectorPath": "propertyInspector/run.html"
  }]
