    "Name": "FilmCraft Edit Control",
    "Icon": "assets/action",
    "States": [{
      "Image": "assets/action",
      "TitleAlignment": "bottom",
      "TitleColor": "#FFFFFF",
      "FontSize": "12"
    }],
